<Project>
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>CAN_EMIT;UNITY_STANDALONE;UNITY_5_6_OR_NEWER</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyVersion>2.1.6.0</AssemblyVersion>
    <FileVersion>2.1.6.0</FileVersion>
    <Version>2.1.6</Version>
    <Company>Sirenix IVS (OdinSerializer, Apache-2.0); repackaged for ROUNDS MapsExtended compat</Company>
    <Product>OdinSerializer (open source) built as Sirenix.Serialization 2.1.6 drop-in</Product>
    <Copyright>Copyright (c) 2018 Sirenix IVS. Licensed under the Apache License, Version 2.0.</Copyright>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <NoWarn>$(NoWarn);CS1591;CS1723;CS1574;CS1584;CS1658;CS0618;CS0612;CS0414;CS0649;CS0169;CS0436;CS1570;CS1587</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ManagedDir>$(HOME)/Library/Application Support/Steam/steamapps/common/ROUNDS/ROUNDS.app/Contents/Resources/Data/Managed</ManagedDir>
    <OutDir>$(MSBuildThisFileDirectory)out/</OutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(ManagedDir)/UnityEngine*.dll" Private="false" />
  </ItemGroup>
</Project>
