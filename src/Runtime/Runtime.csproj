<Project Sdk="Microsoft.NET.Sdk">
  <!-- rounds-port Runtime: a BepInEx plugin with fixes that have to run in game (Harmony patches), for mods that load
       on the current build but then throw or draw wrong. No UI, no credits, nothing in the menus. Needs the game to
       build (Managed + BepInEx/core). -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>rounds-port.Runtime</AssemblyName>
    <RootNamespace>RoundsPort.Runtime</RootNamespace>
    <Version>1.2.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(Managed)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)/Unity.Localization.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="$(Managed)/Unity.Postprocessing.Runtime.dll" Private="false" />
    <Reference Include="$(Managed)/netstandard.dll" Private="false" />
  </ItemGroup>
</Project>
