diff -ruN -x bin -x obj src/ModdingUtils/Utils/CompatShims.cs build/Utils/CompatShims.cs
--- src/ModdingUtils/Utils/CompatShims.cs	1969-12-31 19:00:00
+++ build/Utils/CompatShims.cs	2026-09-30 23:50:44
@@ -0,0 +1,99 @@
+// ROUNDS 2025 (Unity 2022.3) compatibility shims. Not part of upstream ModdingUtils 0.4.8.
+using System;
+using HarmonyLib;
+using UnityEngine;
+using UnityEngine.Localization;
+
+namespace ModdingUtils.Utils
+{
+    internal static class CompatShims
+    {
+        // CardInfo.cardName is now a private serialized field that UnboundLib 4.x no longer fills for custom cards
+        // (it sets m_localizedCardName to a LocalizedString whose entry key is the card title instead).
+        private static readonly AccessTools.FieldRef<CardInfo, string> cardNameRef = AccessTools.FieldRefAccess<CardInfo, string>("cardName");
+
+        // Returns the card's untranslated name, matching the pre-update CardInfo.cardName semantics as closely as possible:
+        // 1. legacy serialized cardName if non-empty (vanilla cards, old-style mod cards)
+        // 2. the localized-name table key when the card has no translation table entry of its own (UnboundLib CustomCard: key == title)
+        // 3. CardInfo.CardName (localized name, or GameObject name if no localized string)
+        internal static string GetCardName(CardInfo card)
+        {
+            if (card == null) return null;
+            try
+            {
+                string raw = cardNameRef(card);
+                if (!string.IsNullOrEmpty(raw)) return raw;
+            }
+            catch { }
+            try
+            {
+                LocalizedString ls = card.LocalizedCardName;
+                if (ls != null && !ls.IsEmpty && card.GetComponent<UnboundLib.Cards.CustomCard>() != null)
+                {
+                    string key = ls.TableEntryReference.Key;
+                    if (!string.IsNullOrEmpty(key)) return key;
+                }
+            }
+            catch { }
+            try
+            {
+                string name = card.CardName;
+                if (name != null) return name;
+            }
+            catch { }
+            return card.name ?? "";
+        }
+
+        // Replacement for the removed CardBar.OnHover(CardInfo, Vector3): same steps as CardBar.OnHover(CardBarButton)
+        // minus CardBarHandler.SetSelection (no button to point at).
+        private static readonly AccessTools.FieldRef<CardBar, GameObject> currentCardRef = AccessTools.FieldRefAccess<CardBar, GameObject>("m_currentCard");
+        private static readonly System.Reflection.MethodInfo doesHoverSetter = AccessTools.PropertySetter(typeof(CardBar), "DoesHover");
+        private static void setDoesHover(CardBar bar, bool v) { doesHoverSetter?.Invoke(bar, new object[] { v }); }
+
+        internal static GameObject ShowCardOnBar(CardBar bar, CardInfo card)
+        {
+            GameObject current = currentCardRef(bar);
+            if (current != null) UnityEngine.Object.Destroy(current);
+            setDoesHover(bar, true);
+            current = CardChoice.instance.AddCardVisual(card, bar.cardPos.transform.position);
+            currentCardRef(bar) = current;
+            foreach (Collider2D col in current.transform.root.GetComponentsInChildren<Collider2D>()) col.enabled = false;
+            Canvas canvas = current.GetComponentInChildren<Canvas>();
+            if (canvas != null) canvas.sortingLayerName = "MostFront";
+            SetScaleToZero sstz = current.GetComponentInChildren<SetScaleToZero>();
+            if (sstz != null)
+            {
+                sstz.enabled = false;
+                sstz.transform.localScale = Vector3.one * 1.15f;
+            }
+            return current;
+        }
+
+        // Replacement for the body shared by both SilentAddToCardBar copies (CardBar fields ci/source and
+        // CardBarButton.card were removed/renamed to m_source / m_cardInfo; label is now UILocalizedString.Text).
+        private static readonly AccessTools.FieldRef<CardBar, GameObject> sourceRef = AccessTools.FieldRefAccess<CardBar, GameObject>("m_source");
+        private static readonly AccessTools.FieldRef<CardBar, System.Collections.Generic.List<CardBarButton>> cardsRef = AccessTools.FieldRefAccess<CardBar, System.Collections.Generic.List<CardBarButton>>("m_cards");
+
+        internal static void AddButtonToCardBar(CardBar bar, CardInfo card, string text)
+        {
+            GameObject source = sourceRef(bar);
+            GameObject gameObject = UnityEngine.Object.Instantiate<GameObject>(source, source.transform.position, source.transform.rotation, source.transform.parent);
+            gameObject.transform.localScale = Vector3.one;
+            UILocalizedString label = gameObject.GetComponentInChildren<UILocalizedString>(true);
+            if (label != null && label.Text != null)
+            {
+                label.Text.text = text; // Text getter also marks the label as modified so Awake() won't blank it
+            }
+            else
+            {
+                TMPro.TextMeshProUGUI tmp = gameObject.GetComponentInChildren<TMPro.TextMeshProUGUI>(true);
+                if (tmp != null) tmp.text = text;
+            }
+            CardBarButton button = gameObject.GetComponent<CardBarButton>();
+            button.m_cardInfo = card;
+            gameObject.gameObject.SetActive(true);
+            // keep D-pad hover navigation and ClearBar() aware of the new button, as CardBar.AddCard does
+            cardsRef(bar)?.Insert(0, button);
+        }
+    }
+}
