<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bench-only plugin (never shipped): drives the game by itself for in-game tests. See Pilot.cs. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>rounds-bench.pilot</AssemblyName>
    <Nullable>disable</Nullable>
    <!-- Managed comes from the repo's Directory.Build.props (GameDir); BepInEx/core from a copy with BepInEx in it -->
    <Core Condition="'$(Core)' == ''">$(GameDir)\BepInEx\core</Core>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(Managed)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.Physics2DModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.SpriteMaskModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Managed)\InControl.dll" Private="false" />
    <Reference Include="$(Managed)\PhotonUnityNetworking.dll" Private="false" />
    <Reference Include="$(Managed)\PhotonRealtime.dll" Private="false" />
    <Reference Include="$(Managed)\Photon3Unity3D.dll" Private="false" />
    <Reference Include="$(Core)\BepInEx.dll" Private="false" />
    <Reference Include="$(Core)\0Harmony.dll" Private="false" />
  </ItemGroup>
</Project>
